# macOS AirPlay Receiver may already listen on 5000; use 5001 if needed.
PORT=5001
NODE_ENV=development

# Use a local MongoDB or an Atlas URI. Never commit real credentials.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/medbed_os

# Required. Generate a long random value for real deployments.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by Express and Socket.IO.
CLIENT_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

AI_SERVICE_URL=http://127.0.0.1:8000

# ML prediction service (medbed-ml — 3-model stack: transfer, vitals, safety).
# Runs on port 8001 to avoid conflict with the simpler AI service on 8000.
# Start: cd medbed-ml && uvicorn api.ml_api:app --host 127.0.0.1 --port 8001
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=5000

# Safety monitor and data-quality thresholds.
PATIENT_MONITOR_INTERVAL_MS=15000
ALERT_ACK_TIMEOUT_SECONDS=300
VITALS_STALE_SECONDS=60
SENSOR_OFFLINE_SECONDS=180

# Optional override for the synthetic seed accounts.
DEMO_PASSWORD=WardZero!2026

# ── Ward Zero demo tuning (optional) ─────────────────────────────────────────
# Minutes of virtual time each SIMULATED reading represents in the 24-48h forecast.
SIM_MINUTES_PER_READING=60
# Caregiver presence thresholds (minutes without activity) and shift auto-close (hours)
CAREGIVER_IDLE_MINUTES=15
CAREGIVER_UNRESPONSIVE_MINUTES=45
CAREGIVER_MAX_SHIFT_HOURS=12
# Caregiver missed check-in timeout in seconds (alerts if no caregiver on duty for a patient)
CAREGIVER_CHECKIN_TIMEOUT_SECONDS=1800
# Seconds an alert may wait while no caregiver is checked in before coverage escalation
COVERAGE_GRACE_SECONDS=60
# Set to a file path to make the home-hub replay queue survive restarts (durable buffer)
# GATEWAY_BUFFER_PATH=./data/gateway-buffer.json
